# Public template only. Do not commit real secrets.
SECRET_KEY=replace-me-with-a-long-random-secret
DEBUG=False
USE_SQLITE=False

# Comma-separated hosts/origins.
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax

# PostgreSQL production database.
DB_NAME=notesfx
DB_USER=notesfx
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Security and product limits.
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
MAX_NOTES_PER_USER=5
NOTE_CREATE_RATE_LIMIT=5
NOTE_CREATE_RATE_WINDOW_SECONDS=3600
COMMENT_CREATE_RATE_LIMIT=10
COMMENT_CREATE_RATE_WINDOW_SECONDS=600
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
NOTE_PASSWORD_RATE_LIMIT=5
NOTE_PASSWORD_RATE_WINDOW_SECONDS=900

# Email provider. Keep real credentials in deployment secrets.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# AI provider. Keep real API keys in deployment secrets.
AI_PROVIDER=gemini
AI_MIN_INTERVAL_SECONDS=15
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash,gemini-2-flash-exp,gemini-2.5-flash-lite,gemini-2-flash,gemini-2.0-flash,gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
